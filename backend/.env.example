# Alumnia Backend Environment Variables
PROJECT_NAME="Alumnia — AI-Powered Alumni Networking Platform"
API_V1_STR="/api"
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration
# Defaults to local SQLite for instant zero-config startup:
DATABASE_URL="sqlite:///./alumnia.db"
# For Supabase PostgreSQL, provide your pooled or direct transaction connection string:
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Supabase Credentials (Optional for client-side storage / edge integrations)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# AI / LLM Configuration (Optional: fallback engine is built-in and enabled by default)
OPENAI_API_KEY=""
GEMINI_API_KEY=""
LLM_MODEL="gpt-4o-mini"
